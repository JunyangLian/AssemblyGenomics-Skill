// M1 阶段的 Nextflow 配置骨架（仅 failsafe 与资源占位，不含真实组装 process）。
// 真实组装 process 属 M2。此处只确认打包约定：进程资源上限、失败重试与全局预算占位。

process {
    // failsafe：失败重试上限，禁止无界重试
    maxRetries = 2
    errorStrategy = 'retry'
}

// 全局资源预算占位。M0 拿到真实服务器信息后由 preflight 探测并覆写，
// 不沿用任何其他项目的资源假设。
env {
    COPILOT_CPU_LIMIT   = ''
    COPILOT_MEM_GB_LIMIT = ''
    COPILOT_DISK_GB_LIMIT = ''
}

// 版本锁定策略见 docs/environment.md 与 docs/technology_registry.md。