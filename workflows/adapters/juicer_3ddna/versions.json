  "human_gate": {
    "after": "3d_dna_scaffold",
    "tool": "juicebox",
    "required_state": "WAITING_REVIEW",
    "approve_transition": "approved -> proceed to haplotig purge"
  },
  "constraint": "BAM 不默认等于组装源；Hi-C 互作必须来自 Hi-C FASTQ + Juicer，不由任意 bam 推断"
